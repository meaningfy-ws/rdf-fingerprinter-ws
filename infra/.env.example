# Copy to infra/.env (git-ignored) and replace every "change-me". Never commit infra/.env.
# `make up` reads this file for both the compose file and the containers.
# The library's own operational variables (RDF_FINGERPRINTER_PROFILE_FILE and the like) are not
# supported by this service: do not set them.

# --- API (Connexion on gunicorn with the uvicorn worker) ---
RDF_FINGERPRINTER_API_LOCATION=http://fingerprinter-api
RDF_FINGERPRINTER_API_PORT=4020
RDF_FINGERPRINTER_API_SECRET_KEY=change-me
RDF_FINGERPRINTER_GUNICORN_API_WORKERS=2
SHOW_SWAGGER_UI=true
# Seconds before gunicorn restarts a silent worker (a slow download or upload)
RDF_FINGERPRINTER_GUNICORN_TIMEOUT=1200
# Upload cap in megabytes (413 above it)
RDF_FINGERPRINTER_MAX_UPLOAD_MB=512

# --- UI (Flask on gunicorn) ---
RDF_FINGERPRINTER_UI_LOCATION=http://fingerprinter-ui
RDF_FINGERPRINTER_UI_PORT=8020
RDF_FINGERPRINTER_UI_SECRET_KEY=change-me
RDF_FINGERPRINTER_GUNICORN_UI_WORKERS=1
# Set to true when the UI is served over HTTPS
RDF_FINGERPRINTER_UI_SECURE_COOKIES=false

# --- Fuseki (a temporary dataset per uploaded file) ---
# The port is the one published on the host, on 127.0.0.1 only; the containers reach Fuseki on 3030.
RDF_FINGERPRINTER_FUSEKI_LOCATION=http://fuseki
RDF_FINGERPRINTER_FUSEKI_PORT=3030
RDF_FINGERPRINTER_FUSEKI_USERNAME=admin
RDF_FINGERPRINTER_FUSEKI_PASSWORD=change-me
RDF_FINGERPRINTER_FUSEKI_JVM_ARGS=-Xmx2g

# --- Redis (the Celery broker); published on 127.0.0.1 only ---
RDF_FINGERPRINTER_REDIS_LOCATION=redis://redis
RDF_FINGERPRINTER_REDIS_PORT=6379

# --- PlantUML server (renders the class diagrams); published on 127.0.0.1 only ---
RDF_FINGERPRINTER_PLANTUML_LOCATION=http://plantuml
RDF_FINGERPRINTER_PLANTUML_PORT=8080

# --- Flower (the Celery dashboard); published on 127.0.0.1 only ---
RDF_FINGERPRINTER_FLOWER_PORT=5557

# --- Storage and logging ---
# Relative to the working directory: /app in the images (volumes), the repository root for `make run-*`
RDF_FINGERPRINTER_FILE_DB=db
RDF_FINGERPRINTER_REPORTS_DB=reports
RDF_FINGERPRINTER_LOG_LEVEL=info
