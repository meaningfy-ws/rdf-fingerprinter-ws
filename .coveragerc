# coverage.py configuration (no-src layout: measure the top-level package directly).
[run]
branch = True
source = fingerprinter
# Exercised only by `make test-containers` (D-12), so outside the unit/feature floor.
# The legacy adapters (celery, sparql_adapter, helpers) leave with task 2.5.
omit =
    fingerprinter/adapters/*
    fingerprinter/bootstrap.py

[report]
fail_under = 80
show_missing = true
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    ^\s+\.\.\.$
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
